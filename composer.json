{
  "name": "nkaajtooj/webman-starter",
  "type": "project",
  "keywords": [
    "high performance",
    "http service"
  ],
  "license": "MIT",
  "description": "High performance HTTP Service Framework.",
  "repositories": {
    "migrations": {
      "type": "vcs",
      "url":  "https://github.com/leekung/webman-migrations.git"
    }
  },
  "require": {
    "php": ">=8.3",
    "ext-curl": "*",
    "ext-dom": "*",
    "ext-json": "*",
    "ext-pdo": "*",
    "ext-zip": "*",
    "ext-redis": "*",
    "workerman/webman-framework": "^2.1",
    "monolog/monolog": "^2.0",
    "webman/console": "^2.2",
    "webman/database": "^2.1",
    "webman/think-orm": "^2.1",
    "illuminate/pagination": "^12.69",
    "illuminate/events": "^12.69",
    "symfony/var-dumper": "^7.4",
    "webman/redis": "^2.1",
    "webman/validation": "^2.2",
    "webman/blade": "^1.5",
    "leekung/webman-migrations": "dev-main",
    "webman-tech/laravel-cache": "^12.0",
    "webman-tech/laravel-filesystem": "^12.0",
    "webman-tech/laravel-http": "^12.0",
    "webman-tech/laravel-validation": "^12.0",
    "webman-tech/auth": "^5.1",
    "vlucas/phpdotenv": "^5.7"
  },
  "suggest": {
    "ext-event": "For better performance. "
  },
  "autoload": {
    "psr-4": {
      "": "./",
      "app\\": "./app",
      "App\\": "./app",
      "app\\View\\Components\\": "./app/view/components"
    }
  },
  "scripts": {
    "post-package-install": [
      "support\\Plugin::install"
    ],
    "post-package-update": [
      "support\\Plugin::install"
    ],
    "pre-package-uninstall": [
      "support\\Plugin::uninstall"
    ],
    "post-create-project-cmd": [
      "support\\Setup::run"
    ],
    "setup-webman": [
      "support\\Setup::run"
    ]
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
